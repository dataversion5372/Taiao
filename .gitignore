# ── OS / editor cruft ──────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ── Python build tooling ───────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Moved to ../RPG-archive (parked / dev-only, never shipped) ──────
/backup/
/tools/npc_brain/
/tools/npc_training/
/assets/venv_app/
/assets/sprite_review_tool/
/item_pick.json

# ── Dropped LC3D voxel subsystem (archived; not in the shipped bundle) ──
/js/legacy3d.js
/js/lc-bestiary.js
/js/sprites/lc-cache-data.js
/libs/legacy-engine.js

# ── Assets: the game ships ONLY sheets/ + sfx/ (+ provenance licenses). ──
# All dev-only sprite-pipeline source has been moved to ../RPG-archive/assets/.
# This ignore keeps any stray regenerated source out of the tracked tree.
/assets/*
!/assets/sfx/
!/assets/sheets/
!/assets/LICENSE-*.txt

# Birdsong: the CC BY-NC-SA recordings themselves stay OUT (that license is
# incompatible with this repo's CC BY-SA asset grant, and NC forbids resale —
# see README "Credits"); the per-clip attribution text is small, plain text,
# and is exactly what an NC license requires whoever distributes it to carry,
# so it ships even though the audio it describes doesn't. Regenerated by
# tools/fetch_birdsong.py whenever the bank is refetched.
!/assets/birdsong/
/assets/birdsong/*.ogg

# Large offline source sprite libraries (dev-only, not fetched at runtime)
/tilesheets/
/tiny-creatures/

# Node build tooling (added during optimization phase)
/node_modules/

# Secrets — never commit
/api.txt

# ── NPC dialogue pipeline: scripts are tracked, corpora/models are not ──
# (bank + embeddings + in-browser ONNX runtime total ~400MB; clones fall
# back to canned NPC lines. Ship via LFS or a release bundle if wanted.)
/tools/npc_dialogue/bank.jsonl
/tools/npc_dialogue/bank.jsonl.pre-dedup
/tools/npc_dialogue/generated/
/libs/npcml/
