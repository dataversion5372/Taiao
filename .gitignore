# ── OS / editor cruft ──────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ── Python build tooling ───────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Moved to ../RPG-archive (parked / dev-only, never shipped) ──────
/backup/
/tools/npc_brain/
/assets/venv_app/
/assets/sprite_review_tool/

# ── Assets: the game ships ONLY sheets/ + sfx/ (+ provenance licenses). ──
# All dev-only sprite-pipeline source has been moved to ../RPG-archive/assets/.
# This ignore keeps any stray regenerated source out of the tracked tree.
/assets/*
!/assets/sfx/
!/assets/sheets/
!/assets/LICENSE-*.txt

# Large offline source sprite libraries (dev-only, not fetched at runtime)
/tilesheets/
/tiny-creatures/

# Node build tooling (added during optimization phase)
/node_modules/

# Secrets — never commit
/api.txt
